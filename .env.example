# ---- GramArogya AI — environment variable template ----
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# PostgreSQL connection (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/gramarogya

# JWT / auth
SECRET_KEY=replace_with_a_secure_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# CORS — the frontend dev server origin
CORS_ORIGINS=http://localhost:5173

# App
APP_ENV=development

# Optional LLM narrative summaries (Groq / Llama). Leave blank to use rule-based fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
