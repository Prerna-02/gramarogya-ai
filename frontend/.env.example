# ---- GramArogya AI frontend — environment template ----
# Copy to `.env` for local overrides. NEVER commit `.env`.
#
# In development the Vite dev server proxies "/api" to the backend
# (see vite.config.js), so this can be left blank. Set it to a full URL
# (e.g. https://api.example.com) when pointing at a deployed backend.
VITE_API_URL=
